  <process id="procesoDeVentaMauescuelaTOBE" name="Proceso de venta Mauescuela TO-BE" isExecutable="true" flowable:candidateStarterGroups="flowableUser">
    <documentation>Proceso central de negocio de Mapuescuela: gestiona el pago, la validación del
    comprobante, el vencimiento del plazo de 24 horas, la actualización de inventario y la
    entrega (retiro o despacho) de un pedido ya generado por la aplicación web.</documentation>
    <extensionElements>
      <flowable:candidates-type><![CDATA[all]]></flowable:candidates-type>
      <design:stencilid><![CDATA[BPMNDiagram]]></design:stencilid>
      <design:creationdate><![CDATA[2026-08-21T01:52:27.908Z]]></design:creationdate>
      <design:description><![CDATA[Proceso central de negocio de Mapuescuela: gestiona el pago, la validación del
    comprobante, el vencimiento del plazo de 24 horas, la actualización de inventario y la
    entrega (retiro o despacho) de un pedido ya generado por la aplicación web.]]></design:description>
      <design:modificationdate><![CDATA[2026-08-28T01:56:48.319Z]]></design:modificationdate>
    </extensionElements>
    <laneSet id="laneSet_procesoDeVentaMauescuelaTOBE">
      <lane id="cliente" name="Cliente">
        <flowNodeRef>boundary_timer_24h</flowNodeRef>
        <flowNodeRef>f_timer</flowNodeRef>
        <flowNodeRef>ut_cargar_comprobante</flowNodeRef>
        <flowNodeRef>ut_datos_personales_modalidad_entrega</flowNodeRef>
        <flowNodeRef>reenviar_comprobante</flowNodeRef>
        <flowNodeRef>startnoneevent1</flowNodeRef>
        <flowNodeRef>f3</flowNodeRef>
        <flowNodeRef>SequenceFlow_49</flowNodeRef>
        <flowNodeRef>SequenceFlow_48</flowNodeRef>
        <flowNodeRef>f1</flowNodeRef>
      </lane>
      <lane id="Lane_3" name="Voluntario">
        <flowNodeRef>registraInformacionDespacho</flowNodeRef>
        <flowNodeRef>ut_registrar_retiro</flowNodeRef>
        <flowNodeRef>ut_revisar_comprobante</flowNodeRef>
        <flowNodeRef>ut_preparar_retiro</flowNodeRef>
        <flowNodeRef>ut_preparar_despacho</flowNodeRef>
        <flowNodeRef>gw_pago_aprobado</flowNodeRef>
        <flowNodeRef>gw_modalidad_entrega</flowNodeRef>
        <flowNodeRef>end_finalizado_retiro</flowNodeRef>
        <flowNodeRef>SequenceFlow_53</flowNodeRef>
        <flowNodeRef>f11</flowNodeRef>
        <flowNodeRef>f141</flowNodeRef>
        <flowNodeRef>SequenceFlow_36</flowNodeRef>
        <flowNodeRef>f13</flowNodeRef>
        <flowNodeRef>f5</flowNodeRef>
        <flowNodeRef>f7</flowNodeRef>
        <flowNodeRef>SequenceFlow_47</flowNodeRef>
        <flowNodeRef>f9</flowNodeRef>
        <flowNodeRef>f12</flowNodeRef>
      </lane>
      <lane id="Lane_47" name="Web service">
        <flowNodeRef>st_cancelar_pedido_vencido</flowNodeRef>
        <flowNodeRef>cancelarPedido</flowNodeRef>
        <flowNodeRef>notificarPago</flowNodeRef>
        <flowNodeRef>st_actualizar_inventario</flowNodeRef>
        <flowNodeRef>st_notificar_rechazo</flowNodeRef>
        <flowNodeRef>nPedido</flowNodeRef>
        <flowNodeRef>nofificarEstado</flowNodeRef>
        <flowNodeRef>notificarEnvioCliente</flowNodeRef>
        <flowNodeRef>end_cancelado_vencimiento</flowNodeRef>
        <flowNodeRef>end_pago_rechazado</flowNodeRef>
        <flowNodeRef>end_finalizado_despacho</flowNodeRef>
        <flowNodeRef>f15</flowNodeRef>
        <flowNodeRef>SequenceFlow_51</flowNodeRef>
        <flowNodeRef>SequenceFlow_38</flowNodeRef>
        <flowNodeRef>f8</flowNodeRef>
        <flowNodeRef>SequenceFlow_50</flowNodeRef>
        <flowNodeRef>SequenceFlow_52</flowNodeRef>
        <flowNodeRef>SequenceFlow_46</flowNodeRef>
        <flowNodeRef>f14</flowNodeRef>
      </lane>
    </laneSet>
    <boundaryEvent id="boundary_timer_24h" name="Vencimiento 24h" attachedToRef="ut_cargar_comprobante" cancelActivity="true">
      <extensionElements>
        <design:stencilid><![CDATA[IntermediateTimerEventBoundary]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
      <timerEventDefinition>
        <timeDuration>PT24H</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="f_timer" sourceRef="boundary_timer_24h" targetRef="st_cancelar_pedido_vencido">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
