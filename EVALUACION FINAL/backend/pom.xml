<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>cl.mapuescuela</groupId>
    <artifactId>mapuescuela-backend</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>mapuescuela-backend</name>
    <description>
        Backend unificado de Mapuescuela (Grupo 7): expone los Web Services
        REST (pedidos, notificaciones, inventario) y aloja los External
        Workers de Flowable (PedidoWorkers, NotificacionWorkers,
        InventarioWorker) en una sola aplicación Spring Boot.
    </description>

    <properties>
        <java.version>17</java.version>
        <!-- IMPORTANTE: la version 2.0.0 de esta libreria (27-feb-2026) ya
             está armada para Spring Boot 4 / Jackson 3 (tools.jackson),
             incompatible con spring-boot-starter-parent 3.3.5 de este
             proyecto. La 1.0.0 es de la epoca de Spring Boot 3.x y es la
             que corresponde acá. -->
        <flowable-worker-client.version>1.0.0</flowable-worker-client.version>
    </properties>

    <dependencies>
        <!-- Recursos REST estilo JAX-RS (PedidoResource, NotificacionResource,
             InventarioResource) montados sobre Spring Boot vía Jersey -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jersey</artifactId>
        </dependency>

        <!-- Persistencia JPA (NotificacionEntity, InventarioEntity) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Base de datos: SQLite (archivo unico, portable, facil de
             revisar con cualquier cliente SQLite; reemplaza a H2). -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>

        <!-- Hibernate no trae un dialecto de SQLite en su core; viene
             en el modulo separado "community dialects". -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>

        <!-- Soporte multipart/form-data en Jersey, necesario para el
             endpoint de carga del comprobante (POST /pedidos/{id}/comprobante). -->
        <dependency>
            <groupId>org.glassfish.jersey.media</groupId>
            <artifactId>jersey-media-multipart</artifactId>
        </dependency>

        <!-- Cliente oficial de Flowable para External Worker Tasks:
             org.flowable.external.client.AcquiredExternalWorkerJob y
             org.flowable.external.worker.annotation.FlowableWorker vienen
             de aquí (ver https://github.com/flowable/flowable-external-client-java) -->
        <dependency>
            <groupId>org.flowable.client.spring</groupId>
            <artifactId>flowable-external-worker-spring-boot-starter</artifactId>
            <version>${flowable-worker-client.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Necesario en esta máquina: sin esto, el cliente de
                         Flowable falla con ConnectException/ClosedChannelException
                         al conectar (probablemente por el adaptador de red
                         virtual que instala VirtualBox, que confunde a Java
                         al elegir la interfaz de salida). -->
                    <jvmArguments>-Djava.net.preferIPv4Stack=true -Djava.net.preferIPv6Addresses=false</jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
